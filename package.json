{
  "name": "onedash",
  "version": "0.1.0",
  "private": true,
  "description": "oneda.sh — personal, E2EE PWA dashboard on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "build:app": "node scripts/build-app.mjs",
    "dev": "npm run build:app && wrangler dev",
    "deploy": "npm run build:app && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply onedash_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply onedash_db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.90.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "^11.0.0",
    "marked": "^18.0.11",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "yjs": "^13.6.32"
  }
}
